DATABASE_URL=mongodb://127.0.0.1/portfolio
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob token for media uploads (added automatically when you connect a Blob store on Vercel)
BLOB_READ_WRITE_TOKEN=

# Gmail account that sends contact form notifications. SMTP_PASS is a Gmail App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_USER=
SMTP_PASS=
# Inbox that receives the notifications (defaults to SMTP_USER)
CONTACT_TO_EMAIL=
